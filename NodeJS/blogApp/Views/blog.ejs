<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head.ejs') %>
    <title>Blog</title>
</head>
<body>
     <%- include('./partials/navbar.ejs') %>
    <div class="container">
        <h1><%= blog.title %></h1>
        <img width="700pc" src="<%blog.coverImageURL %>" alt="">
        <p><%=blog.body %></p>

    </div>
    <div class="container mt-4">
        <img src="<%= blog.createBy.profileImageURL" alt="">
        <h1><%= blog.createdBy.fullName</h1>
    </div>
    <div class="container mt-3">
        <form>
        <h1>Comments</h1>
  <div class="mb-3">
    
    <input placeholder="Enter your Comment" type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
    
  </div>
  
 
  <button type="submit" class="btn btn-primary">Submit</button>
</form>
    </div>

     <%- include('./partials/scripts.ejs') %>
</body>
</html>